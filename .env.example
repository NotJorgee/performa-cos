# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional connection pooler fallback
DATABASE_POOLER_URL=

# Supabase Storage (avatars, DAR photos, LOI PDFs, fast-track memos)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Authentication (JWT)
JWT_SECRET_KEY=replace_with_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
OTP_EXPIRE_MINUTES=10

# App URLs & CORS
APP_FRONTEND_URL=https://localhost:5173
# JSON list for additional allowed origins in production
# CORS_ORIGINS=["https://your-production-domain.com"]

# Direct SMTP Email (Optional - leave blank to skip email sending in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EVSU PerformaCOS
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Google Gemini AI (Optional - system falls back cleanly to offline rules if blank)
GEMINI_API_KEY=

# Server Mode
DEBUG=True
